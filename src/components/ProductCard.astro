---
import { Picture } from 'astro:assets';
import type { Product } from '@data/products';
import { localePath, type Dictionary, type Lang } from '@i18n/index';

interface Props {
  product: Product;
  lang: Lang;
  ui: Dictionary['ui'];
  /** Home page: badges, smaller pack. */
  compact?: boolean;
}

const { product: p, lang, ui, compact = false } = Astro.props;
---

<a
  href={localePath(lang, `/product/${p.id}`)}
  class="flex flex-col overflow-hidden rounded-[22px] border border-navy/9 bg-paper transition-[transform,box-shadow] duration-250 hover:-translate-y-1.5 hover:shadow-[0_22px_44px_rgba(20,54,94,.13)]"
>
  <div class="flex h-[300px] items-center justify-center px-5 py-6" style={{ background: p.tint }}>
    <Picture
      src={p.img}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[240, 360, 480, 680]}
      sizes="(max-width: 700px) 80vw, 340px"
      pictureAttributes={{ class: 'contents' }}
      alt={p.name}
      class:list={[
        'max-h-full max-w-[86%] object-contain drop-shadow-[0_18px_26px_rgba(20,54,94,.2)]',
        compact ? 'max-h-[240px]' : 'max-h-[252px]',
      ]}
    />
  </div>
  <div class="flex flex-1 flex-col gap-[9px] px-[22px] pt-[22px] pb-[26px]">
    <div class="text-[10.5px] font-bold tracking-[.14em] text-khaki">{p.kicker}</div>
    <h3 class:list={['m-0 font-heading text-[22px] font-semibold text-navy', compact && 'leading-[1.2]']}>{p.name}</h3>
    <p class="m-0 flex-1 text-[13.5px] leading-[1.55] text-muted">{p.short}</p>
    {compact && (
      <div class="mt-1.5 flex flex-wrap gap-1.5">
        {p.badges.map((b) => (
          <span class="rounded-full bg-navy/6 px-2.5 py-[5px] text-[11px] font-semibold text-navy">{b}</span>
        ))}
      </div>
    )}
    <div class="mt-3 flex items-center justify-between border-t border-navy/8 pt-3.5">
      <span class="text-[13px] font-semibold text-earth">{ui.priceTbd}</span>
      <span class="text-[13.5px] font-bold text-gold-ink">{ui.details} →</span>
    </div>
  </div>
</a>
