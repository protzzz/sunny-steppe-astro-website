---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import logo from '@assets/logo-mark.png';
import { Header } from '@components/Header';
import Footer from '@components/Footer.astro';
import ConsentBanner from '@components/ConsentBanner.astro';
import { getNavItems } from '@data/navigation';
import { getDict, localePath, type Lang } from '@i18n/index';
import { resolveGaId } from '@lib/analytics';
import { jsonLdString, siteJsonLd } from '@lib/structured-data';
import { PUBLIC_GA_ID, PUBLIC_NOINDEX } from 'astro:env/client';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** og:image name from src/pages/og/[name].jpg.ts: a product id, or "site". */
  ogImage?: string;
  /** No canonical/hreflang (404). */
  noindex?: boolean;
  /** Product id for analytics events. */
  product?: string;
}

const { title, lang, ogImage = 'site', noindex = false, product } = Astro.props;
const t = getDict(lang);
const description = Astro.props.description ?? t.meta.description;
// Route without /kz, for the RU/KZ switch. 404 falls back to the home page.
const route = noindex ? '/' : Astro.url.pathname.replace(/^\/kz(?=\/|$)/, '').replace(/\/$/, '') || '/';
const navItems = getNavItems(t.nav);
// ISO code "kk"; "kz" is only our URL prefix.
const htmlLang = lang === 'kz' ? 'kk' : 'ru';

const canonicalURL = new URL(localePath(lang, route), Astro.site);
const ruAlternateURL = new URL(localePath('ru', route), Astro.site);
const kzAlternateURL = new URL(localePath('kz', route), Astro.site);
// 1200×630 share preview, built by src/pages/og/[name].jpg.ts.
const imageURL = new URL(`/og/${ogImage}.jpg`, Astro.site);
const ogLocale = lang === 'kz' ? 'kk_KZ' : 'ru_RU';
// React island: pass a ready 2x image instead of <Image>.
const headerLogo = await getImage({ src: logo, width: 68, format: 'webp' });
// GA4: production build with PUBLIC_GA_ID only; loads after consent (lib/analytics.ts).
const gaId = resolveGaId(PUBLIC_GA_ID, import.meta.env.PROD);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- From the logo mark: npm run icons (scripts/make-icons.mjs). -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbf7ef" />
    <!-- Preload Cyrillic only. Variable fonts: one file, registered as weight 400. -->
    <Font cssVariable="--font-playfair" preload={[{ subset: 'cyrillic', weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-manrope" preload={[{ subset: 'cyrillic', weight: 400 }]} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="ru" href={ruAlternateURL} />
        <link rel="alternate" hreflang="kk" href={kzAlternateURL} />
        <link rel="alternate" hreflang="x-default" href={ruAlternateURL} />
      </>
    )}
    {PUBLIC_NOINDEX && !noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sunny Steppe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script is:inline type="application/ld+json" set:html={jsonLdString(siteJsonLd(Astro.site!))} />
  </head>
  <body>
    <!-- Skip link for keyboard users. -->
    <a
      href="#main"
      class="sr-only z-[100] rounded-full bg-navy px-5 py-3 text-[14px] font-semibold text-cream hover:text-cream focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t.ui.skipToContent}
    </a>
    <div class="flex min-h-screen flex-col bg-cream">
      <!-- Links work without JS; only the burger needs hydration. -->
      <Header
        client:idle
        logo={headerLogo.src}
        lang={lang}
        route={route}
        items={navItems}
        menuExtraItems={[{ route: '/documents', label: t.footer.documents }]}
        writeLabel={t.ui.write}
        menuLabel={t.ui.menu}
      />

      {lang === 'kz' && (
        <div class="bg-navy px-5 py-[9px] text-center text-[12.5px] tracking-[.02em] text-milk">{t.ui.kzNotice}</div>
      )}

      <main id="main" tabindex="-1" class="flex-1 focus:outline-none" data-product={product}>
        <slot />
      </main>

      <Footer lang={lang} navItems={navItems} t={t.footer} cookieSettings={!!gaId} />
    </div>

    {gaId && (
      <ConsentBanner gaId={gaId} siteUrl={Astro.site!.href} privacyHref={localePath(lang, '/privacy')} t={t.consent} />
    )}
  </body>
</html>
