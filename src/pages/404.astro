---
import Default from '@layouts/Default.astro';
import { localePath } from '@i18n/index';
---

<Default lang="ru" title="Страница не найдена — Sunny Steppe" noindex>
  <div class="container flex flex-col items-center gap-3 py-[clamp(72px,10vw,120px)] text-center">
    <div class="font-heading text-[clamp(56px,9vw,120px)] leading-none text-navy/15">404</div>
    <h1 class="font-heading text-[clamp(26px,3.4vw,38px)] leading-[1.16] font-medium text-navy">
      Страница не найдена · Бет табылмады
    </h1>
    <p class="max-w-[46ch] text-[15px] leading-[1.6] text-lead">
      Такой страницы не существует или она была перемещена.<br />
      Мұндай бет жоқ немесе басқа мекенжайға көшірілген.
    </p>
    <a
      href={localePath('ru')}
      class="mt-3 inline-flex items-center gap-[9px] rounded-full bg-navy px-[26px] py-3.5 text-[14.5px] font-semibold text-cream shadow-[0_10px_26px_rgba(20,54,94,.2)]"
    >
      На главную → Басты бетке
    </a>
  </div>
</Default>
