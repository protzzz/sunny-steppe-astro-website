---
import Default from '@layouts/Default.astro';
import Kicker from '@components/Kicker.astro';
import ProductCard from '@components/ProductCard.astro';
import { contacts } from '@data/contacts';
import { getProducts } from '@data/products';
import { getDict, langPaths, langFromParam } from '@i18n/index';

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = getDict(lang);
---

<Default lang={lang} title={t.meta.catalog}>
  <div class="container pt-[clamp(40px,5vw,72px)] pb-[clamp(56px,7vw,96px)]">
    <Kicker>{t.catalog.kicker}</Kicker>
    <h1 class="mt-3 font-heading text-[clamp(32px,4.6vw,54px)] leading-[1.1] font-medium text-navy">
      {t.catalog.title}
    </h1>
    <p class="mt-3.5 max-w-[56ch] text-[16px] leading-[1.62] text-lead">{t.catalog.lead}</p>

    <div class="cards-3 mt-10 gap-5">
      {getProducts(lang).map((p) => <ProductCard product={p} lang={lang} ui={t.ui} />)}
    </div>

    <!-- "Coming soon" banner. -->
    <section
      class="relative mt-[clamp(28px,4vw,44px)] overflow-hidden rounded-[28px] border border-gold/24 bg-linear-[160deg] from-linen to-sand px-6 py-[clamp(40px,6vw,64px)] text-center"
    >
      <div
        class="pointer-events-none absolute -top-[160px] left-1/2 size-[420px] -translate-x-1/2 rounded-full bg-radial from-[rgba(226,182,96,.28)] to-[rgba(226,182,96,0)] to-68%"
      >
      </div>
      <div class="relative mx-auto flex max-w-[600px] flex-col items-center">
        <div
          class="inline-flex items-center gap-[9px] rounded-full border border-navy/10 bg-white/72 py-[7px] pr-[15px] pl-[11px] text-[11px] font-bold tracking-[.14em] text-navy"
        >
          <span class="block size-2 rounded-full bg-honey"></span>{t.catalog.soonKicker}
        </div>
        <h2 class="mt-5 font-heading text-[clamp(28px,3.6vw,42px)] leading-[1.12] font-medium text-navy">
          {t.catalog.soonTitle}
        </h2>
        <p class="mt-4 max-w-[52ch] text-[clamp(15px,1.3vw,16.5px)] leading-[1.62] text-lead">{t.catalog.soonText}</p>
        <a
          href={contacts.instagramHref}
          data-track-location="catalog"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex items-center gap-[9px] rounded-full border-[1.5px] border-navy/20 bg-paper px-[24px] py-3 text-[14.5px] font-semibold text-navy hover:border-gold"
        >
          Instagram {contacts.instagram}
          <span>→</span>
        </a>
      </div>
    </section>
  </div>
</Default>
