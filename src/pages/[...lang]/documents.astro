---
import Default from '@layouts/Default.astro';
import Kicker from '@components/Kicker.astro';
import { DocumentRow } from '@components/DocumentRow';
import { contacts } from '@data/contacts';
import { getDeclarations } from '@data/documents';
import { getDict, langPaths, langFromParam } from '@i18n/index';

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = getDict(lang);
const cardKicker = 'text-[10.5px] font-bold tracking-[.14em]';
---

<Default lang={lang} title={t.meta.documents} description={t.docs.lead}>
  <div class="mx-auto max-w-[1100px] px-5 pt-[clamp(40px,5vw,76px)] pb-[clamp(56px,7vw,96px)]">
    <Kicker>{t.docs.kicker}</Kicker>
    <h1 class="mt-3 font-heading text-[clamp(32px,4.6vw,52px)] leading-[1.08] font-medium text-navy">
      {t.docs.title}
    </h1>
    <p class="mt-3.5 max-w-[56ch] text-[16px] leading-[1.62] text-lead">{t.docs.lead}</p>

    <div class="mt-9 flex flex-col gap-3">
      {
        getDeclarations(lang).map((d) => (
          <DocumentRow
            eyebrow={d.productName}
            title={t.docs.declaration}
            meta={[`№ ${d.number} · ${d.valid}`]}
            href={d.file}
            product={d.product}
            openLabel={t.docs.open}
            downloadLabel={t.docs.download}
          />
        ))
      }
    </div>

    <div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-4">
      <div class="flex flex-col gap-3 rounded-[20px] border border-gold/24 bg-sand/50 p-6">
        <div class:list={[cardKicker, 'text-bronze']}>{t.docs.partnersKicker}</div>
        <p class="m-0 text-[14.5px] leading-[1.62] text-lead">{t.docs.partnersText}</p>
        <a
          href={contacts.whatsappHref}
          data-track-location="documents"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 self-start border-b border-navy/30 pb-0.5 text-[14px] font-semibold hover:border-gold"
        >
          {t.ui.write} →
        </a>
      </div>
      <div class="flex flex-col gap-3 rounded-[20px] border border-navy/9 bg-paper p-6">
        <div class:list={[cardKicker, 'text-khaki']}>{t.docs.detailsKicker}</div>
        <p class="m-0 text-[13.5px] leading-[1.7] text-lead">{t.docs.detailsText}</p>
      </div>
    </div>
  </div>
</Default>
