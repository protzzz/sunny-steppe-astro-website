---
import { Picture } from 'astro:assets';
import Default from '@layouts/Default.astro';
import Kicker from '@components/Kicker.astro';
import { getProducts } from '@data/products';
import { getDict, langPaths, localePath, langFromParam } from '@i18n/index';

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = getDict(lang);

const h2 = 'm-0 font-heading text-[clamp(23px,2.8vw,32px)] leading-[1.16] font-medium text-navy';
---

<Default lang={lang} title={t.meta.about}>
  <section class="bg-linear-[168deg] from-linen to-cream">
    <div class="mx-auto max-w-[900px] px-5 py-[clamp(44px,5.5vw,84px)]">
      <Kicker>{t.about.kicker}</Kicker>
      <h1 class="mt-3 font-heading text-[clamp(32px,4.6vw,56px)] leading-[1.06] font-medium text-navy">
        {t.about.title}
      </h1>
      <p class="mt-5 text-[clamp(16px,1.5vw,19px)] leading-[1.62] text-lead">{t.about.lead}</p>
    </div>
  </section>

  <section class="mx-auto flex max-w-[900px] flex-col gap-[clamp(30px,4vw,48px)] px-5 py-[clamp(44px,5.5vw,76px)]">
    {
      t.about.blocks.map((b) => (
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(220px,100%),1fr))] items-start gap-[clamp(18px,3vw,40px)]">
          <h2 class={h2}>{b.t}</h2>
          <p class="m-0 text-[15.5px] leading-[1.72] text-lead">{b.d}</p>
        </div>
      ))
    }

    <div class="border-t border-navy/12 pt-[clamp(26px,3.5vw,40px)]">
      <h2 class:list={[h2, 'mb-[18px]']}>{t.about.lineTitle}</h2>
      <div class="cards-3 gap-3.5">
        {
          getProducts(lang).map((p) => (
            <a
              href={localePath(lang, `/product/${p.id}`)}
              class="flex items-center gap-3.5 rounded-[18px] border border-navy/9 bg-paper px-4 py-3.5 hover:border-gold/50"
            >
              <Picture
                src={p.img}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[56, 112]}
                sizes="46px"
                pictureAttributes={{ class: 'contents' }}
                alt=""
                class="h-14 w-[46px] object-contain"
              />
              <span class="flex flex-col gap-1">
                <span class="text-[14.5px] leading-[1.3] font-semibold text-navy">{p.name}</span>
                <span class="text-[13px] leading-[1.45] text-muted">{t.about.line[p.id]}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Default>
