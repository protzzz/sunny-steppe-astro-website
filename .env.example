# Copy to .env and fill in. Variables set in the environment (e.g. in CI or on the hosting) override this file.

# Public address of the site, no trailing slash. Used for canonical, hreflang, og:url/og:image,
# the sitemap and robots.txt, and as the only domain where Google Analytics is loaded.
PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave it empty here: set it only in the hosting's
# production build settings, so local builds and tests never carry the real ID.
# Empty — no analytics and no consent banner.
PUBLIC_GA_ID=

# Test copy of the site (another domain or folder). true — noindex on every page and "Disallow: /"
# in robots.txt, so search engines don't index it. Must stay empty or false in the production build.
PUBLIC_NOINDEX=

# ── Deploy to PS Cloud (ps.kz, Plesk) over FTPS ─────────────────────────────────────────────────────
# Not read by the site: only for uploading dist/ to the hosting. No PUBLIC_ prefix, ever — PUBLIC_
# values are written into the pages and anyone could read them. In GitHub put these into
# Settings → Secrets and variables → Actions → Secrets, not into Variables.
# Use a separate FTP user limited to the site folder, not the main Plesk login.
FTP_HOST=sunnysteppe.kz
FTP_USER=
FTP_PASSWORD=
# Folder on the server the contents of dist/ go into (Plesk's document root).
FTP_REMOTE_DIR=/httpdocs
