# Copy to .env. Environment variables (CI, hosting) override this file.

# Site address, https, no trailing slash. Base for canonical, sitemap, robots.txt and GA4.
PUBLIC_SITE_URL=

# GA4 ID (G-XXXXXXXXXX). Keep empty here, set only on the hosting. Empty: no analytics, no banner.
PUBLIC_GA_ID=

# true for a test copy: noindex + "Disallow: /". Empty in production.
PUBLIC_NOINDEX=

# ── Deploy to PS Cloud (ps.kz, Plesk) over FTPS ─────────────────────────────────────────────────────
# Upload only, not read by the site. Never prefix with PUBLIC_ (it ends up in the pages).
# In GitHub: Actions → Secrets. Use an FTP user limited to the site folder.
FTP_HOST=sunnysteppe.kz
FTP_USER=
FTP_PASSWORD=
# Server folder for dist/ (Plesk document root).
FTP_REMOTE_DIR=/httpdocs
