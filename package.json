{
  "name": "sunny-steppe-astro-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && npm run test:links",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test:links": "node scripts/check-build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_MODE=dev playwright test",
    "test:e2e:running": "E2E_MODE=dev BASE_URL=http://localhost:4321 playwright test",
    "test": "npm run test:unit && PUBLIC_GA_ID=G-TEST000000 npm run build && E2E_PREBUILT=1 playwright test",
    "lint": "eslint .",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
